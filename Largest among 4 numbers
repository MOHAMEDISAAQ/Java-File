import java.util.Scanner;
public class Largestoffour {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();
        int c = sc.nextInt();
        int d = sc.nextInt();
        int largest;
        if (a > b && a > c && a > d) {
            largest = a;
        } else if (b > c && b > d) {
            largest = b;
        } else if (c > d) {
            largest = c;
        } else {
            largest = d;
        }
        System.out.println(largest);
        sc.close();
    }
}
