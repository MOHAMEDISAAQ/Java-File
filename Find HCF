import java.util.Scanner;

public class HCF_LCM {
    public static int findHCF(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a; 
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

       
        int a = sc.nextInt();
        int b = sc.nextInt();

        int hcf = findHCF(a, b);

       
        int lcm;
        if (a == 0 || b == 0)
            lcm = 0;
        else
            lcm = (a * b) / hcf;

       
        System.out.println(hcf);
        System.out.println(lcm);

        sc.close();
    }
}
